# ===== LinguaFlow Backend Configuration =====
# Copy this file to `.env` and fill in your keys.

# ---- Server ----
HOST=0.0.0.0
PORT=8000
# Comma separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Database ----
DATABASE_URL=sqlite:///./linguaflow.db

# ---- ASR (Automatic Speech Recognition) ----
# Provider: "faster-whisper" (local, free) | "openai" (Whisper API) | "mock" (no deps, for testing)
ASR_PROVIDER=mock
# faster-whisper model size: tiny | base | small | medium | large-v3
WHISPER_MODEL=base
# Device: cpu | cuda
WHISPER_DEVICE=cpu
# Compute type: int8 | int8_float16 | float16 | float32
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=en
WHISPER_VAD_FILTER=true

# ---- Translation ----
# Provider: "mymemory" (free API, recommended for MVP) | "libretranslate" | "openai" | "gemini" | "mock"
TRANSLATION_PROVIDER=mymemory
TRANSLATION_SOURCE_LANG=English
TRANSLATION_TARGET_LANG=Chinese
# Free MyMemory API. MYMEMORY_EMAIL is optional but can improve free quota stability.
MYMEMORY_URL=https://api.mymemory.translated.net/get
MYMEMORY_EMAIL=
# LibreTranslate is another free/open option, but public instances may be unstable or rate-limited.
LIBRETRANSLATE_URL=https://libretranslate.com/translate
LIBRETRANSLATE_API_KEY=

# ---- OpenAI ----
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TRANSLATION_MODEL=gpt-4o-mini
OPENAI_WHISPER_MODEL=whisper-1

# ---- Gemini ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ---- Audio pipeline ----
# Sample rate expected from the browser (Hz)
AUDIO_SAMPLE_RATE=16000
# Emit a partial transcription every N milliseconds
PARTIAL_INTERVAL_MS=900
# Silence (ms) that marks the end of an utterance -> finalize segment
SILENCE_TIMEOUT_MS=800
# Maximum utterance length (ms) before forcing a finalize
MAX_UTTERANCE_MS=12000
